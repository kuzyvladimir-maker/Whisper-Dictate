{
  "control_socket": "/tmp/whisper-dictate.sock",
  "language": "ru",
  "sample_rate": 16000,
  "tap_threshold_seconds": 0.4,
  "double_click_window_seconds": 0.5,
  "enter_to_stop": true,
  "paste_after_transcription": true,
  "smart_cleanup": true,
  "initial_prompt": "",
  "model_filename": "ggml-large-v3-turbo.bin",
  "sounds": true,
  "max_recording_seconds": 600,
  "keep_recordings": 200,
  "keep_transcripts": 2000,
  "history_size": 25,
  "hearing_alert": true,
  "hearing_level": 0.03,
  "hearing_min_level": 0.008,
  "hearing_alert_after": 6.0,
  "hearing_pause_alert_after": 20.0,
  "beam_size": 5,
  "best_of": 5,
  "vad": true,
  "vad_min_duration_seconds": 25,
  "persistent_server": true,
  "persistent_server_max_seconds": 60,
  "confidence_retry_threshold": 0.8,
  "min_chars_per_second": 0.5,
  "vocabulary_prompt": false,
  "suppress_nst": true,
  "start_beep_delay_builtin": 0.15,
  "live_chunking": true,
  "cleanup_backend": "off",
  "cleanup_min_words": 7,
  "chunk_min_seconds": 40,
  "chunk_max_seconds": 75,
  "mic_idle_close_seconds": 0
}